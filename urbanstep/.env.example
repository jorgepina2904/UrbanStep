# UrbanStep - Variables de Entorno para Supabase & Vercel
# Copia este archivo como .env en el directorio urbanstep/ para conectar con tu proyecto Supabase real.

# URL de tu proyecto Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Llave pública Anon de Supabase
VITE_SUPABASE_ANON_KEY=

# Nombre de la tienda
VITE_STORE_NAME="UrbanStep Venezuela"

# Tasa BCV inicial (opcional, fallback por defecto si no hay conexión)
VITE_DEFAULT_BCV_RATE=42.50

# WhatsApp de atención al cliente (activa el botón flotante de la tienda). Ej: 04141234567
VITE_WHATSAPP_PHONE=
